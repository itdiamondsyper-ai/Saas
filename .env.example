# ---------------------------------------------------------------------------
# FlowPilot environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings → Environment Variables.
#
# With no Supabase variables set, FlowPilot runs in DEMO MODE: built-in auth and
# a local JSON data store seeded with the "Vertex Creative" workspace.
# ---------------------------------------------------------------------------

# Public URL of the app (used for auth email links, invite links and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for Stripe webhooks, account deletion and the cron job. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers → API keys) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring monthly Price IDs for the paid plans (Products → your product → Pricing)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Scheduled jobs ----------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Force demo mode on/off regardless of Supabase variables ("true" / "false")
FLOWPILOT_DEMO_MODE=
# Signs demo-mode session cookies. Set a long random string if you deploy demo mode publicly.
DEMO_SESSION_SECRET=
# Where demo mode stores data (defaults to ./.data locally and /tmp on Vercel)
DEMO_DATA_DIR=
# "View Demo" in Supabase mode signs into this account (create it yourself, e.g. via supabase/seed.sql)
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
